import json
import sys
from dataclasses import dataclass, field

# ---------------------------------------------------------------------------
# Mock data
# ---------------------------------------------------------------------------

CUSTOMERS = {
    "C-1001": {"customer_name": "John", "email": "john@gmail.com", "is_verified": True},
    "C-1002": {"customer_name": "Travolta", "email": "travolta@gmail.com", "is_verified": False},
}

ORDERS = {
    "ORD-12345": {"customer_id": "C-1001", "total": 150.00, "status": "delivered"},
    "ORD-789": {"customer_id": "C-1002", "total": 89.99, "status": "delivered"},
}

# ---------------------------------------------------------------------------
# Tool implementations (plain business logic, no enforcement here)
# ---------------------------------------------------------------------------


def get_customer(email: str) -> str:
    for customer_id, customer in CUSTOMERS.items():
        if customer["email"].lower() == email.strip().lower():
            return json.dumps({
                "customer_id": customer_id,
                "email": customer["email"],
                "is_verified": customer["is_verified"],
            })
    return json.dumps({"error": f"No customer found with email {email}"})


def lookup_order(customer_id: str) -> str:
    orders = [
        {"order_id": order_id, **order}
        for order_id, order in ORDERS.items()
        if order["customer_id"] == customer_id
    ]
    if orders:
        return json.dumps(orders)
    return json.dumps({"error": f"No orders found for customer {customer_id}"})


def process_refund(order_id: str, amount: float) -> str:
    order = ORDERS.get(order_id)
    if order is None:
        return json.dumps({"error": f"Order {order_id} not found."})
    if amount <= 0:
        return json.dumps({"error": "Refund amount must be greater than zero."})
    if amount > order["total"]:
        return json.dumps({"error": f"Refund {amount} exceeds the order total of {order['total']}."})
    return json.dumps({"status": "refunded", "order_id": order_id, "amount": amount})


# ---------------------------------------------------------------------------
# Tool schemas
# ---------------------------------------------------------------------------

